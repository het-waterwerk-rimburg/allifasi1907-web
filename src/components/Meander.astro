---
/**
 * Greek meander (key) band — the printed border of the tin and the section
 * divider the style guide asks for. Pure SVG pattern, scales to any width.
 */
interface Props {
  /** Colour of the key; defaults to Ancient Gold. */
  color?: string;
  class?: string;
}

const { color = 'var(--gold)', class: className } = Astro.props;
const id = `meander-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['meander', className]}
  width="100%"
  height="24"
  aria-hidden="true"
  focusable="false"
  style={`color:${color}`}
>
  <defs>
    <pattern id={id} width="32" height="24" patternUnits="userSpaceOnUse">
      <path
        d="M0 22.5H32 M0 1.5H32 M4 22.5V6.5H25V17.5H11V11.5H19"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="square"
      ></path>
    </pattern>
  </defs>
  <rect width="100%" height="24" fill={`url(#${id})`}></rect>
</svg>

<style>
  .meander {
    display: block;
    width: 100%;
  }
</style>
