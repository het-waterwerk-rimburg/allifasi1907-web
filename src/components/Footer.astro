---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-mark.png';
import Icon from './Icon.astro';
import Meander from './Meander.astro';
import { href, t, type Lang, type PageKey } from '../i18n/config';
import { SITE, DIRECTIONS_URL, WHATSAPP_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();

const nav: { key: PageKey; label: string }[] = [
  { key: 'menu', label: s.nav.menu },
  { key: 'story', label: s.nav.story },
  { key: 'restaurant', label: s.nav.restaurant },
  { key: 'cuisine', label: s.nav.cuisine },
  { key: 'reviews', label: s.nav.reviews },
  { key: 'reservations', label: s.nav.contact },
];
---

<footer class="site-footer tin tin--deep">
  <Meander />
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={href(lang, 'home')} class="footer-brand" aria-label={s.nav.home}>
        <Image src={mark} alt="" width={64} height={62} loading="lazy" class="footer-brand__mark" />
        <span class="footer-brand__word" aria-hidden="true">
          <span class="footer-brand__name">Alli Fasi</span>
          <span class="footer-brand__tag">Traditional Meze &amp; Cafe Bar</span>
          <span class="footer-brand__since">Rodos · Since 1907</span>
        </span>
      </a>
      <p class="muted">{s.footer.tagline}</p>
      <address>{s.contact.address}</address>
    </div>

    <nav aria-label={s.footer.navTitle}>
      <h2 class="site-footer__title">{s.footer.navTitle}</h2>
      <ul class="site-footer__list">
        {
          nav.map((item) => (
            <li>
              <a href={href(lang, item.key)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">{s.footer.actionsTitle}</h2>
      <ul class="site-footer__list site-footer__actions">
        <li>
          <a href={href(lang, 'reservations')}><Icon name="calendar" />{s.nav.reserve}</a>
        </li>
        <li>
          <a href={`tel:${SITE.phoneEnglish.tel}`}><Icon name="phone" />{s.common.callUs} · {SITE.phoneEnglish.display}</a>
        </li>
        <li>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer"
            ><Icon name="whatsapp" />{s.common.whatsapp}<span class="visually-hidden">{s.common.opensNewTab}</span></a
          >
        </li>
        <li>
          <a href={DIRECTIONS_URL} target="_blank" rel="noopener noreferrer"
            ><Icon name="route" />{s.common.getDirections}<span class="visually-hidden">{s.common.opensNewTab}</span></a
          >
        </li>
        {
          SITE.instagram && (
            <li>
              <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
            </li>
          )
        }
        {
          SITE.facebook && (
            <li>
              <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">{s.footer.hoursTitle}</h2>
      <p class="site-footer__hours">
        <strong>{s.hours.days}</strong><br />
        {s.hours.time}<br />
        <span class="muted">{s.hours.kitchen}</span><br />
        <span class="muted">{s.hours.sunday}</span>
      </p>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} Alli Fasi 1907. {s.footer.rights}</p>
    <ul>
      <li><a href={href(lang, 'privacy')}>{s.footer.privacy}</a></li>
      <li><a href={href(lang, 'cookies')}>{s.footer.cookies}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 40px;
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1080px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.3fr 1fr;
    }
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 1rem;
    text-decoration: none;
    color: var(--cream);
  }

  .footer-brand :global(.footer-brand__mark) {
    width: 56px;
    height: auto;
  }

  .footer-brand__word {
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.1;
  }

  .footer-brand__name {
    font-family: var(--font-cinzel);
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .footer-brand__tag {
    font-size: 0.875rem;
    color: var(--beige);
  }

  .footer-brand__since {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .site-footer__brand address {
    font-style: normal;
    color: var(--on-tin-muted);
  }

  .site-footer__title {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .site-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    text-decoration: none;
    color: var(--cream);
  }

  .site-footer__list a:hover {
    color: var(--gold);
  }

  .site-footer__actions :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--gold);
  }

  .site-footer__hours {
    line-height: 1.8;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--teal-line);
    font-size: 0.8125rem;
    color: var(--on-tin-muted);
  }

  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__legal ul {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__legal a {
    color: var(--on-tin-muted);
  }

  .site-footer__legal a:hover {
    color: var(--cream);
  }
</style>
